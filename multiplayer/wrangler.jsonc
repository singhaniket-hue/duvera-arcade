{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "duvera-arcade-rooms",
  "main": "worker.mjs",
  "compatibility_date": "2026-09-24",
  "workers_dev": true,
  "durable_objects": {"bindings": [{"name":"ROOMS","class_name":"FourRoom"}]},
  "migrations": [{"tag":"v1","new_sqlite_classes":["FourRoom"]}],
  "observability": {"enabled":false}
}

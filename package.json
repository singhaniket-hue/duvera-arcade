{
  "name": "duvera-arcade",
  "version": "0.1.0",
  "private": true,
  "description": "A static arcade with Clumsy Bird, 2048 and Hextris",
  "license": "GPL-3.0",
  "scripts": {
    "dev": "node scripts/serve.mjs",
    "start": "node scripts/serve.mjs",
    "check": "node scripts/check.mjs",
    "check:mobile": "node scripts/mobile-check.mjs",
    "check:desktop": "node scripts/desktop-check.mjs",
    "build": "node scripts/build.mjs",
    "check:creator": "node scripts/check-creator.mjs",
    "check:stack": "node scripts/check-stack.mjs && node scripts/stack-browser-check.mjs",
    "check:four": "node scripts/check-four.mjs && node scripts/check-rooms.mjs && node scripts/four-browser-check.mjs",
    "check:dash": "node scripts/check-dash.mjs && node scripts/dash-browser-check.mjs",
    "check:smash": "node scripts/check-smash.mjs && node scripts/smash-browser-check.mjs",
    "check:draw": "node scripts/check-draw.mjs && node scripts/check-party-room.mjs && node scripts/draw-browser-check.mjs",
    "check:quiz": "node scripts/check-quiz.mjs && node scripts/quiz-browser-check.mjs",
    "check:multiplayer": "node scripts/check-multiplayer.mjs",
    "check:party-rigor": "node scripts/check-party-rigor.mjs",
    "check:submissions": "node scripts/check-submissions-local.mjs"
  },
  "engines": {
    "node": ">=18"
  }
}
